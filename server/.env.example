# Copy to .env for local runs (node --env-file=.env src/index.js). Never commit real values.

# Required
DATABASE_URL=postgres://rw:rwlocal@127.0.0.1:5432/rw
# First admin, created on first boot when the users table is empty. Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional. Render sets PORT and RENDER_EXTERNAL_URL. Set APP_BASE_URL only for a custom domain.
APP_BASE_URL=
PORT=3000
NODE_ENV=development
SESSION_DAYS=14

# Texting stays off until the EIN and A2P 10DLC registration are done.
SMS_ENABLED=false

# Twilio (number lookup and purchase). Inert when blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AREA_CODES=781,339,617

# Vapi (voice assistant). Inert when blank. Requests send User-Agent ReceptWise-Control-Panel/1.0.
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
# Shared secret Vapi sends as X-Vapi-Secret. Generate: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_ID=
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_MODEL=eleven_flash_v2_5
VAPI_MODEL=gpt-4.1
VAPI_TRANSCRIBER_MODEL=nova-3
# ReceptWise Google Calendar tools (check availability, book demo). Override per future client.
VAPI_CALENDAR_TOOL_IDS=f3655080-9833-42a8-888e-f93ff7d2bfde,ccf9a444-6462-4513-95c4-955c73142285
VAPI_MAX_CALL_SECONDS=600
# Pilot assistant and number. Defaults match the live receptionist; override to point elsewhere.
VAPI_ASSISTANT_ID=c3c8899c-e42d-494b-bf47-3af37f942341
VAPI_PHONE_NUMBER_ID=60a44606-c827-4f01-b381-852e247a8003
PILOT_PHONE_E164=+17817057179

# Where "talk to a person" transfers go when a business has no transfer number of its own (E.164).
TRANSFER_TO_NUMBER=

# Encrypts Meta page tokens at rest. Required before Connect with Meta will store anything.
TOKEN_ENCRYPTION_KEY=

# Facebook Login for Business. Both must be set or the Integrations page stays on "Needs Meta app setup".
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Optional. When set, the OAuth dialog uses this Facebook Login for Business configuration instead of META_OAUTH_SCOPES.
META_LOGIN_CONFIG_ID=
# Optional. Defaults to APP_BASE_URL/api/integrations/meta/callback
META_REDIRECT_URI=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic,business_management

# Trello. Optional server-wide key. A key pasted on Integrations is encrypted per business and wins over these.
# How to get them: https://trello.com/power-ups/admin then the key's authorize link
# https://trello.com/1/authorize?expiration=never&name=ReceptWise&scope=read,write&response_type=token&key=YOUR_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=

# Website generator. Inert when GITHUB_TOKEN is blank (the panel returns 409 and names this variable).
# Classic token: repo scope, allowed to create public repositories in the org.
# Fine-grained: Contents and Pull requests (read/write), Administration to create repos, Pages if you want Pages turned on.
GITHUB_TOKEN=
GITHUB_ORG=atulitllc
