# Copy to .env for local runs (node --env-file=.env src/index.js). Never commit real values.

# Required
DATABASE_URL=postgres://rw:rwlocal@localhost:5432/rw
# First admin, created on first boot when the users table is empty. Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional. Render sets RENDER_EXTERNAL_URL automatically; set APP_BASE_URL only for a custom domain.
APP_BASE_URL=
PORT=3000
NODE_ENV=development

# Texting stays off until the EIN and A2P 10DLC registration are done.
SMS_ENABLED=false

# Twilio (number purchase). Inert when blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AREA_CODES=781,339,617

# Vapi (voice assistant). Inert when blank.
VAPI_API_KEY=
# Shared secret Vapi sends as X-Vapi-Secret on webhooks. Generate: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=
# ElevenLabs voice ID chosen in the Vapi dashboard. If blank, Vapi's default voice is used.
VAPI_VOICE_ID=
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_MODEL=eleven_flash_v2_5
VAPI_MODEL=gpt-4.1
VAPI_TRANSCRIBER_MODEL=nova-3
# Comma-separated IDs of the Google Calendar tools (check availability + create event) made in the Vapi dashboard.
VAPI_CALENDAR_TOOL_IDS=
VAPI_MAX_CALL_SECONDS=600

# Where "talk to a person" transfers go when a business has no transfer number of its own (E.164).
TRANSFER_TO_NUMBER=
